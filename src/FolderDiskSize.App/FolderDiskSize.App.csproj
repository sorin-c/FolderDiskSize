<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the WPF project compile on Linux/macOS build machines; it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>FolderDiskSize</AssemblyName>
    <RootNamespace>FolderDiskSize.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FolderDiskSize.Core\FolderDiskSize.Core.csproj" />
  </ItemGroup>
</Project>
