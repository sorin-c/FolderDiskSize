<Application x:Class="FolderDiskSize.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="RightAligned" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="4,0" />
        </Style>

        <!-- Thin bar with the percentage printed over it, used for "% Parent" and "Used %". -->
        <Style x:Key="PercentBar" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Foreground" Value="#9CC3EE" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C8D6E5" />
        </Style>
    </Application.Resources>
</Application>
